# ============================================================
#  Toolkit Hub - ek hi .env.local sab tools ke liye
#  Copy karo:  cp .env.example .env.local   (Windows: copy .env.example .env.local)
# ============================================================

# ---------- Google OAuth (Inbox + ReelForge upload + Search Console) ----------
# Ek hi Client ID/Secret teeno tools ke liye. https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPTIONAL. Khali chhod do to app apna URL khud pehchan leti hai.
# Local:   http://localhost:3000/api/auth/google/callback
# Vercel:  https://your-app.vercel.app/api/auth/google/callback
# (Jo bhi ho, wahi URL Google Cloud Console ke "Authorized redirect URIs" mein add karna hai)
GOOGLE_REDIRECT_URI=

# ---------- AI provider (Groq preferred; Gemini remains a fallback) ----------
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Browser-search research requires a Groq model that supports browser search.
GROQ_MODEL=openai/gpt-oss-20b
# Optional fallback key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional fallback model. Google purane models band karta rehta hai, isliye yahan se badal sakte ho.
GEMINI_MODEL=gemini-3.1-flash-lite

# ---------- PageSpeed Insights (Website Review) ----------
# Free: https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
# Optional hai, magar key ke baghair Google jaldi rate-limit kar deta hai.
PAGESPEED_API_KEY=

# ---------- VoiceRSS (ReelForge voiceover) ----------
# Free, no credit card: https://www.voicerss.org/personel/
VOICERSS_API_KEY=

# ============================================================
#  Toolkit Hub - ek hi .env.local sab tools ke liye
#  Copy karo:  cp .env.example .env.local   (Windows: copy .env.example .env.local)
# ============================================================

# ---------- AI provider (Groq preferred; Gemini remains a fallback) ----------
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Separate keys for the specialized research assistants.
# These can be different Groq keys from the same account.
SCIENCE_GROQ_API_KEY=
MEDICAL_GROQ_API_KEY=
# Shared by Business Research and Language Tutor.
SPECIALIST_GROQ_API_KEY=
# Browser-search research requires a Groq model that supports browser search.
GROQ_MODEL=openai/gpt-oss-20b
# Optional fallback key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional fallback model. Google purane models band karta rehta hai, isliye yahan se badal sakte ho.
GEMINI_MODEL=gemini-3.1-flash-lite

# ---------- PageSpeed Insights (Website Review) ----------
# Free: https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
# Optional hai, magar key ke baghair Google jaldi rate-limit kar deta hai.
PAGESPEED_API_KEY=
